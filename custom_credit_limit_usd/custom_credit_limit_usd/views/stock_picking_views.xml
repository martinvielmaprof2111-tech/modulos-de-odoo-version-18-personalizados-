<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Botón de Validar Surtido en el Header -->
            <xpath expr="//header" position="inside">
                <button name="action_validar_surtido" 
                        string="Validar Surtido" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="surtido_validado or picking_type_code != 'outgoing'"/>
            </xpath>

            <!-- Campo indicador Surtido Validado -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="surtido_validado" widget="boolean_toggle" readonly="1"/>
            </xpath>



        </field>
    </record>
</odoo>