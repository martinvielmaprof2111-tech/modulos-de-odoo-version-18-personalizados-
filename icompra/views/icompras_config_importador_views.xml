<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_icompras_api_config" model="ir.actions.act_window">
        <field name="name">Configuración API Sugeridos</field>
        <field name="res_model">icompras.api.config</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <record id="view_icompras_api_config_form" model="ir.ui.view">
        <field name="name">icompras.api.config.form</field>
        <field name="model">icompras.api.config</field>
        <field name="arch" type="xml">
            <form string="Configuración API iCompras Sugeridos">
                <header>
                    <button name="action_import_sugeridos_manual" string="Probar Importación de Sugeridos" type="object" class="oe_highlight" confirm="¿Desea conectarse a la API de iCompras y generar las órdenes de compra pendientes para el día de hoy?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Descripción de la Configuración"/>
                        <h1>
                            <field name="name" placeholder="Ej: API Entrada Principal"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Credenciales de Conexión">
                            <field name="api_url_base" placeholder="https://api.icompras360.com/api"/>
                            <field name="api_email" placeholder="farmacialasballenas2024@gmail.com"/>
                            <field name="api_password" password="True"/>
                        </group>
                        <group string="Control de Entorno">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="api_enabled"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_icompras_api_config_tree" model="ir.ui.view">
        <field name="name">icompras.api.config.list</field>
        <field name="model">icompras.api.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones de API iCompras">
                <field name="name"/>
                <field name="company_id"/>
                <field name="api_url_base"/>
                <field name="api_email"/>
                <field name="api_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_icompras_log_error_tree" model="ir.ui.view">
        <field name="name">icompras.log.error.list</field>
        <field name="model">icompras.log.error</field>
        <field name="arch" type="xml">
            <list string="Historial de Errores de Integración" create="false" edit="false">
                <field name="create_date" string="Fecha y Hora"/>
                <field name="name"/>
                <field name="error_type"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_icompras_log_error_form" model="ir.ui.view">
        <field name="name">icompras.log.error.form</field>
        <field name="model">icompras.log.error</field>
        <field name="arch" type="xml">
            <form string="Detalle del Error de Integración" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Clasificación del Incidente">
                            <field name="name"/>
                            <field name="error_type"/>
                        </group>
                        <group string="Contexto">
                            <field name="create_date" string="Fecha de Registro"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <separator string="Detalles Técnicos / Stack Trace"/>
                    <field name="technical_details" placeholder="Sin detalles adicionales registrados." style="font-family: monospace; white-space: pre;"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_icompras_log_error" model="ir.actions.act_window">
        <field name="name">Historial de Errores iCompras</field>
        <field name="res_model">icompras.log.error</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_icompras_api_config" name="API Sugeridos Entrada" parent="purchase.menu_purchase_config" action="action_icompras_api_config" sequence="101"/>
    <menuitem id="menu_icompras_log_error" name="iCompras: Historial de Errores" parent="purchase.menu_purchase_config" action="action_icompras_log_error" sequence="102"/>
</odoo>