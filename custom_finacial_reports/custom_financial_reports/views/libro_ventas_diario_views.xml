<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_libro_ventas_diario_form" model="ir.ui.view">
        <field name="name">libro.ventas.diario.form</field>
        <field name="model">libro.ventas.diario</field>
        <field name="arch" type="xml">
            <form string="Generar Libro de Ventas Diario (Art. 77)">
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Generar PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_libro_ventas_diario" model="ir.actions.act_window">
        <field name="name">Libro de Ventas Diario </field>
        <field name="res_model">libro.ventas.diario</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>