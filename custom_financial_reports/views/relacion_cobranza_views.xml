<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_relacion_cobranza_form" model="ir.ui.view">
        <field name="name">relacion.cobranza.form</field>
        <field name="model">relacion.cobranza</field>
        <field name="arch" type="xml">
            <form string="Generar Relación de Cobranza">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="user_id" placeholder="Todos los usuarios" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Generar PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_relacion_cobranza" model="ir.actions.act_window">
        <field name="name">Relación de Cobranza</field>
        <field name="res_model">relacion.cobranza</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>