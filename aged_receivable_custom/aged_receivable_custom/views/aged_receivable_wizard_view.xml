<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aged_receivable_wizard" model="ir.ui.view">
        <field name="name">aged.receivable.wizard.form</field>
        <field name="model">aged.receivable.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen de Vencimiento de CxC">
                <group>
                    <group>
                        <field name="date_at"/>
                        <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="user_ids" 
                               widget="many2many_tags"
                               placeholder="TODOS LOS VENDEDORES" 
                               options="{'no_create': True}"/>
                        <field name="state_ids" 
                               widget="many2many_tags"
                               placeholder="TODOS LOS ESTADOS" 
                               options="{'no_create': True}"/>
                        <field name="category_ids" 
                               widget="many2many_tags"
                               placeholder="TODAS LAS CATEGORÍAS" 
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Imprimir PDF" name="print_report" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aged_receivable_wizard" model="ir.actions.act_window">
        <field name="name">Resumen de Vencimiento CxC</field>
        <field name="res_model">aged.receivable.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_aged_receivable_custom"
              name="Resumen de Vencimiento (PDF Custom)"
              parent="account.menu_finance_reports"
              action="action_aged_receivable_wizard"
              sequence="20"/>
</odoo>